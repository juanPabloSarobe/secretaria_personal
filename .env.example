# ============================================================
# Secretaria personal — plantilla de configuración
# Copiar a .env y completar. El .env real nunca se commitea.
# ============================================================

# --- Proveedores de LLM -------------------------------------
# El adaptador `openai_compat` sirve para todos estos.
# IMPORTANTE: el cliente HTTP debe mandar User-Agent propio.
# Sin él, Cloudflare devuelve HTTP 403 / error 1010 (ver spec 11.7).

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# --- Motor: filtro de ruido ---------------------------------
# Tarea fácil, alto volumen. Conviene lo más rápido y barato.
LLM_RUIDO_PROVIDER=openai_compat
LLM_RUIDO_BASE_URL=${GROQ_BASE_URL}
LLM_RUIDO_API_KEY=${GROQ_API_KEY}
LLM_RUIDO_MODEL=llama-3.1-8b-instant

# --- Motor: clasificador ------------------------------------
# Los tres ejes + reglas. Es donde se juega la calidad.
LLM_CLASIFICADOR_PROVIDER=openai_compat
LLM_CLASIFICADOR_BASE_URL=${GROQ_BASE_URL}
LLM_CLASIFICADOR_API_KEY=${GROQ_API_KEY}
LLM_CLASIFICADOR_MODEL=llama-3.3-70b-versatile

# --- Motor: respaldo (opcional) -----------------------------
# Se usa solo si el principal agota su cuota. Groq da 12.000 tokens por
# minuto en el nivel gratuito y cada clasificación consume ~1.500, así que
# el procesamiento masivo lo alcanza. NVIDIA es más lento pero aguanta.
# Si se deja vacío, el sistema trabaja con un solo motor.
LLM_RESPALDO_BASE_URL=${NVIDIA_BASE_URL}
LLM_RESPALDO_API_KEY=${NVIDIA_API_KEY}
LLM_RESPALDO_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Correo institucional -----------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465

# --- Telegram -----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Operación ----------------------------------------------
MODO_SIMULACRO=true          # no envía nada hacia afuera; solo registra
MAX_ENVIOS_POR_HORA=5        # freno de emergencia
ZONA_HORARIA=America/Argentina/Buenos_Aires
