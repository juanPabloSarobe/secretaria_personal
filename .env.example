# ============================================================
# Secretaria personal — plantilla de configuración
# Copiar a .env y completar. El .env real nunca se commitea.
# ============================================================

# --- Proveedores de LLM -------------------------------------
# Se cargan TODOS los que tengas. Cuál se usa NO se decide acá:
# se decide en el código (MOTORES y PREFERENCIA en simulacro.py)
# o con --motor en la línea de comandos. Así nunca hay que
# reescribir este archivo para cambiar de proveedor.
#
# Un motor sin URL cargada simplemente se saltea, así que podés
# dejar los tres escritos aunque uses uno solo.
#
# IMPORTANTE: el cliente HTTP debe mandar User-Agent propio.
# Sin él, Cloudflare devuelve HTTP 403 / error 1010 (ver spec 11.7).

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq además transcribe los audios (Whisper), así que su clave
# se usa para eso aunque el clasificador corra en otro motor.

# --- Correo institucional -----------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465                # 465 es TLS implícito: usar SMTP_SSL, no STARTTLS

# --- Telegram -----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Operación ----------------------------------------------
MODO_SIMULACRO=true          # no envía nada hacia afuera; solo registra
MAX_ENVIOS_POR_HORA=5        # freno de emergencia
CARPETA_RUIDO=INBOX.Ruido    # con prefijo INBOX. y punto, según el servidor
ZONA_HORARIA=America/Argentina/Buenos_Aires
